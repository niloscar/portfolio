{
    "name": "portfolio",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "workspaces": [
        "frontend",
        "backend",
        "shared"
    ],
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
